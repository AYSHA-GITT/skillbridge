# Phase 0 BASELINE: the current backend image (backend/Dockerfile) with PyTorch
# sentence-transformers, built from perf/phase0/requirements-torch.txt (identical to
# backend/requirements.txt except SQLAlchemy 2.0.45, without which pip cannot install it).
# Build context: repository root.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/app/.cache/huggingface \
    PHASE0_VARIANT=torch

RUN apt-get update \
 && apt-get install -y --no-install-recommends libgomp1 curl \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# CPU-only PyTorch first, as in backend/Dockerfile
RUN pip install torch --index-url https://download.pytorch.org/whl/cpu
COPY perf/phase0/requirements-torch.txt /tmp/requirements-torch.txt
RUN pip install -r /tmp/requirements-torch.txt
# Same fairness as the candidate: model fetched at build time, not on first request
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('all-MiniLM-L6-v2')"

COPY backend/ /app/

RUN useradd --create-home --uid 1000 app \
 && mkdir -p uploads/resumes uploads/avatars uploads/evidence .cache/huggingface \
 && chown -R app:app /app
USER app

EXPOSE 5000
CMD ["gunicorn", "wsgi_phase0:app", "--pythonpath", "/phase0,/app", "--bind", "0.0.0.0:5000", \
     "--workers", "1", "--threads", "8", "--timeout", "300", "--access-logfile", "-"]
