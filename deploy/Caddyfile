{$SITE_DOMAIN} {
	encode zstd gzip

	# Flask API (gunicorn). Uploads are capped at 5 MB by Flask; allow a little headroom.
	handle /api/* {
		request_body {
			max_size 6MB
		}
		reverse_proxy api:8000
	}

	# React single-page app: unknown paths fall back to index.html for client-side routing.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
