# Copy to deploy/production.env on the server and fill in. Never commit production.env.
#   cp production.env.example production.env && chmod 600 production.env

# Public hostname (DNS must point at the server before first start), e.g. skillbridge.duckdns.org
SITE_DOMAIN=

# Generate each with:  openssl rand -hex 32
SECRET_KEY=
POSTGRES_PASSWORD=

# --- Email (required for real users: password-reset links are only sent by email) ---
# e.g. Brevo free tier: smtp-relay.brevo.com:587, or a Gmail App Password: smtp.gmail.com:587
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
# For port 465 (implicit TLS) instead: MAIL_PORT=465 and MAIL_USE_SSL=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# --- AI and data providers (use NEW keys, not the ones from your laptop's backend/.env) ---
ACTIVE_AI_PROVIDER=gemini
GEMINI_API_KEY=
YOUTUBE_API_KEY=
GITHUB_TOKEN=

# --- Job providers (optional; company boards work without keys) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
JOOBLE_API_HOST=in.jooble.org
