# ─────────────────────────────────────────────────────────────────────
# SkillBridge backend configuration. Copy to backend/.env and fill in.
# Never commit real values; .env is git-ignored.
# ─────────────────────────────────────────────────────────────────────

# Core
DATABASE_URL=sqlite:///skillbridge.db          # production: postgresql://user:pass@host:5432/dbname
SECRET_KEY=change-me-to-a-long-random-string    # required: signs session cookies
FRONTEND_ORIGINS=http://localhost:3000          # comma-separated allowed CORS origins

# AI / learning resources (optional - features degrade gracefully when missing)
GEMINI_API_KEY=
YOUTUBE_API_KEY=
GITHUB_TOKEN=
# ACTIVE_AI_PROVIDER=gemini                     # gemini | ollama | grok
# OLLAMA_BASE_URL=http://localhost:11434
# RAG_EMBEDDER=auto                             # auto (MiniLM if available) | hash

# ── Job discovery providers ─────────────────────────────────────────
# Which providers to call (comma-separated). Unconfigured ones are skipped and
# reported as "not_configured" - nothing is faked.
JOB_PROVIDERS=adzuna,jooble,arbeitnow

# Adzuna  (register at https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in                    # in = India
ADZUNA_RESULTS_PER_PAGE=50
ADZUNA_MAX_DAYS_OLD=30
JOB_ADZUNA_MAX_REQUESTS_PER_RUN=12   # x12 runs/day must fit your Adzuna plan's daily quota

# Jooble  (request a key at https://jooble.org/api/about)
# Keys are country-domain specific: a jooble.org key returns US jobs only.
# Request a key for the Indian domain and set the matching host.
JOOBLE_API_KEY=
JOOBLE_API_HOST=in.jooble.org
JOOBLE_RESULTS_PER_PAGE=30
JOB_JOOBLE_MAX_REQUESTS_PER_RUN=8    # free plan: 100 requests/day -> 8 x 12 runs = 96

# Arbeitnow (public, no key; mostly Europe-based roles)
ARBEITNOW_REMOTE_ONLY=1
JOB_ARBEITNOW_MAX_REQUESTS_PER_RUN=3

# Demo data: hand-written sample listings (NOT real vacancies). Keep 0 in production.
JOB_INCLUDE_SAMPLE_LISTINGS=0

# Search plan (defaults cover the target roles and Karnataka/India locations;
# students' target careers, preferences and alerts are added automatically)
# JOB_SEARCH_ROLES=software developer,python developer,data analyst,...
# JOB_SEARCH_LOCATIONS=Bengaluru,,Mangaluru,Karnataka,Udupi,Bhatkal,remote

# ── Scheduler ───────────────────────────────────────────────────────
JOB_SYNC_INTERVAL_HOURS=2
JOB_SYNC_RETRY_MINUTES=20            # retry delay after a failed run
JOB_SYNC_LEASE_MINUTES=30            # max run time before another worker may take over
JOB_SCHEDULER_POLL_SECONDS=60        # how often job_worker.py checks whether a sync is due
RUN_JOB_SCHEDULER_IN_PROCESS=0       # 1 = run scheduler thread inside the web process (dev only)

# Freshness rules
JOB_STALE_AFTER_HOURS=72             # not returned by searches for this long -> "not re-confirmed"
JOB_EXPIRE_AFTER_DAYS=21             # not returned for this long -> archived as likely closed
JOB_MAX_POSTING_AGE_DAYS=60          # postings older than this are archived

# Alerts
JOB_ALERT_MAX_PER_RUN=10             # max new matches per alert per sync

# Federated-learning simulation
# FL_CLIP_NORM=1.0
# FL_NOISE_MULTIPLIER=0.5
