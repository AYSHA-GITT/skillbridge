# SkillBridge Environment Configuration Template
# Copy this file to backend/.env and provide your actual API keys. Never commit real keys to version control.

# Database Configuration (SQLite default; or PostgreSQL URI)
DATABASE_URL=sqlite:///skillbridge.db

# Flask Application Secret Key for session signing
SECRET_KEY=your_secure_random_flask_secret_key_here

# Google GenAI / Gemini API Key (Recommended for adaptive verification & career assistant)
GEMINI_API_KEY=your_gemini_api_key_here

# YouTube Data API Key (For learning roadmap resource discovery)
YOUTUBE_API_KEY=your_youtube_api_key_here

# GitHub Personal Access Token (For project recommendation discovery)
GITHUB_TOKEN=your_github_token_here

# Active AI Provider: "gemini" (default), "ollama" (local Qwen), or "grok" (optional cloud)
ACTIVE_AI_PROVIDER=gemini

# Ollama Local LLM Configuration (Optional - for local Qwen execution)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:latest

# Grok / xAI API Configuration (Optional - API format compatible with OpenAI/xAI)
GROK_API_KEY=your_grok_api_key_here
GROK_MODEL=grok-2-latest
